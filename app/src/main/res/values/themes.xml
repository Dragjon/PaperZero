<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window only; Compose draws everything else. Ground color avoids a white flash on launch. -->
    <style name="Theme.PaperZero" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
